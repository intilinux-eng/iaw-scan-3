<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="IES_2.Avalonia.App"
             Name="IAW Scan 3"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://IES_3.Avalonia/Themes/Tokens.axaml" />
                <ResourceInclude Source="avares://IES_3.Avalonia/Themes/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Dark" Accent="#4F8CFF" RegionColor="#0B0E13" />
                <ColorPaletteResources x:Key="Light" Accent="#2563EB" RegionColor="#F3F5F8" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://IES_3.Avalonia/Themes/Styles.axaml" />
    </Application.Styles>

</Application>
