    <x:String x:Key="Settings_ThemeSystem">Come il sistema</x:String>
    <x:String x:Key="Settings_LanguageNote">I nomi di parametri ed errori cambiano lingua al collegamento successivo.</x:String>
    <x:String x:Key="Settings_Log">Registro sessioni</x:String>
    <x:String x:Key="Settings_AutoRecord">Registra automaticamente</x:String>
    <x:String x:Key="Settings_AutoRecordHint">Inizia a registrare i valori appena si collega una centralina vera.</x:String>
    <x:String x:Key="Settings_MaxLog">Dimensione massima (MB)</x:String>
    <x:String x:Key="Settings_MaxLogHint">Oltre questo limite vengono cancellate le sessioni più vecchie.</x:String>
