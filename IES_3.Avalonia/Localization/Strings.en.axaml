<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="IES_2.Avalonia.Localization.StringsEnglish">

    <x:String x:Key="App_Tagline">Engine diagnostics</x:String>

    <x:String x:Key="Nav_Connect">Connect</x:String>
    <x:String x:Key="Nav_Dashboard">Dashboard</x:String>
    <x:String x:Key="Nav_Parameters">Parameters</x:String>
    <x:String x:Key="Nav_Faults">Fault codes</x:String>
    <x:String x:Key="Nav_Tests">Actuator tests</x:String>
    <x:String x:Key="Nav_Graph">Graph</x:String>
    <x:String x:Key="Nav_Adjustments">Adjustments</x:String>
    <x:String x:Key="Nav_Sessions">Session log</x:String>
    <x:String x:Key="Nav_Settings">Settings</x:String>

    <x:String x:Key="Status_NotConnected">Not connected</x:String>
    <x:String x:Key="Status_Simulation">Simulation</x:String>
    <x:String x:Key="Status_Connected">Connected</x:String>
    <x:String x:Key="Status_Recording">Recording</x:String>
    <x:String x:Key="Status_Record">Record</x:String>
    <x:String x:Key="Status_RecordTip">Writes the values being read to this session's log</x:String>
    <x:String x:Key="Status_Disconnect">Disconnect</x:String>

    <x:String x:Key="Banner_CommLost">Communication with the ECU was lost. Turn the ignition off and on, then reconnect.</x:String>
    <x:String x:Key="Banner_Reconnect">Reconnect</x:String>
    <x:String x:Key="Banner_NotAnswering">The cable answers, but the ECU didn't identify itself. Check that the ignition is on and the cable is on the right socket.</x:String>
    <x:String x:Key="Banner_CarNotIdentified">Diagnosis works, but this ECU gives its code only as the ignition comes on, so the exact car isn't known. To identify it: ignition off for 90 seconds, Connect, then ignition on.</x:String>
    <x:String x:Key="Banner_Simulation">Simulation: invented values, no ECU connected.</x:String>

    <x:String x:Key="Dialog_Cancel">Cancel</x:String>

    <x:String x:Key="Connect_Title">Connect to your car</x:String>
    <x:String x:Key="Connect_Subtitle">Find your car, or pick the ECU family if you already know it.</x:String>
    <x:String x:Key="Connect_SearchHint">Search by model: Punto, Delta, 146…</x:String>
    <x:String x:Key="Connect_NoResults">No car matches this search.</x:String>
    <x:String x:Key="Connect_AllEngines">All engine ECUs</x:String>
    <x:String x:Key="Connect_Immobiliser">Immobiliser (FIAT CODE)</x:String>
    <x:String x:Key="Connect_Chosen">YOU'RE CONNECTING TO</x:String>
    <x:String x:Key="Connect_NoChoice">No car chosen yet</x:String>
    <x:String x:Key="Connect_NoChoiceHint">Choose a car from the list.</x:String>
    <x:String x:Key="Connect_FamilyChosen">ECU family chosen directly: the exact car is identified once connected.</x:String>
    <x:String x:Key="Connect_Cable">K-LINE CABLE</x:String>
    <x:String x:Key="Connect_NoPorts">No cable found</x:String>
    <x:String x:Key="Connect_RefreshPorts">Refresh the list of ports</x:String>
    <x:String x:Key="Connect_PlugCable">Plug in the USB K-line cable: it shows up here by itself. Without one, you can try the simulation.</x:String>
    <x:String x:Key="Connect_IsoOnlyAtIgnitionOn">This ECU gives its code only as the ignition comes on, and only after being fully off. To identify the exact car: ignition off for 90 seconds, Connect, then ignition on.</x:String>
    <x:String x:Key="Connect_TestCable">Test the cable</x:String>
    <x:String x:Key="Connect_TestCableTip">Checks the cable with no car needed: the USB side and, if it has its 12 V, the K-line side. Best with the ignition off.</x:String>
    <x:String x:Key="Connect_TestRunning">Testing the cable…</x:String>
    <x:String x:Key="Connect_TestOk">The cable works: both its USB side and its K-line side answer.</x:String>
    <x:String x:Key="Connect_TestNoEcho">USB works, but the cable's K-line side doesn't answer. It usually means no 12 V: check the adapter's clips on the battery, and that the plug is pushed all the way in.</x:String>
    <x:String x:Key="Connect_TestGarbled">The cable answers, but not cleanly. If it's plugged into a car, the ECU may be talking on the line: try again with the ignition off.</x:String>
    <x:String x:Key="Connect_DriverMissing">A cable with a {0} chip is plugged in, but Windows has no working driver for it. Windows Update normally installs it by itself, with an internet connection.</x:String>
    <x:String x:Key="Connect_DriverGet">Get the driver from its maker</x:String>
    <x:String x:Key="Connect_Simulation">Simulation</x:String>
    <x:String x:Key="Connect_SimulationHint">Try the program with no car and no cable.</x:String>
    <x:String x:Key="Connect_Connect">Connect</x:String>
    <x:String x:Key="Connect_Waiting">Waiting for the ECU, for up to 10 seconds. If the ignition is off, turn it on now.</x:String>
    <x:String x:Key="Connect_Cancel">Cancel</x:String>
    <x:String x:Key="Connect_BeforeTitle">Before connecting</x:String>
    <x:String x:Key="Connect_Before1">Ignition on. Engine off or idling.</x:String>
    <x:String x:Key="Connect_Before2">USB K-line cable (VAG-COM KKL 409.1 type) with the 3-pin Fiat adapter. Its clips go on the battery: that 12 V powers the cable's K-line side.</x:String>
    <x:String x:Key="Connect_Before3">Engine ECU and immobiliser have separate sockets: use the one for what you're diagnosing.</x:String>
    <x:String x:Key="Connect_ErrorNoPort">Choose the cable's port first.</x:String>
    <x:String x:Key="Connect_ErrorPortOpen">Can't open the port. It may be in use by another program; on Linux, your user must also be in the dialout group. Details: {0}</x:String>
    <x:String x:Key="Connect_ErrorInvalidEcu">This ECU type isn't valid.</x:String>
    <x:String x:Key="Connect_ErrorCommunication">Communication with the ECU failed: {0}</x:String>

    <x:String x:Key="Dashboard_Title">Dashboard</x:String>
    <x:String x:Key="Dashboard_SizeSmall">Small tiles</x:String>
    <x:String x:Key="Dashboard_SizeNormal">Medium tiles</x:String>
    <x:String x:Key="Dashboard_SizeLarge">Large tiles</x:String>
    <x:String x:Key="Dashboard_Edit">Arrange</x:String>
    <x:String x:Key="Dashboard_EditTip">Reorder or remove tiles</x:String>
    <x:String x:Key="Dashboard_Reset">Reset min/max</x:String>
    <x:String x:Key="Dashboard_ResetTip">Start the lowest and highest values from now</x:String>
    <x:String x:Key="Dashboard_Fullscreen">Full screen</x:String>
    <x:String x:Key="Dashboard_ExitFullscreen">Exit full screen</x:String>
    <x:String x:Key="Dashboard_MoveBack">Move back</x:String>
    <x:String x:Key="Dashboard_MoveForward">Move forward</x:String>
    <x:String x:Key="Dashboard_Remove">Stop reading this parameter</x:String>
    <x:String x:Key="Dashboard_Empty">The dashboard shows the parameters you choose.</x:String>
    <x:String x:Key="Dashboard_Choose">Choose parameters</x:String>

    <x:String x:Key="Parameters_Title">Parameters</x:String>
    <x:String x:Key="Parameters_Search">Search…</x:String>
    <x:String x:Key="Parameters_SelectedOnly">Selected only</x:String>
    <x:String x:Key="Parameters_All">All</x:String>
    <x:String x:Key="Parameters_None">None</x:String>
    <x:String x:Key="Parameters_Hint">Click a parameter to read it: it appears on the dashboard and the graph, and goes into the recording. The fewer you select, the more often each one updates.</x:String>

    <x:String x:Key="Faults_Title">Fault codes</x:String>
    <x:String x:Key="Faults_Clear">Clear codes</x:String>
    <x:String x:Key="Faults_SimulationNote">In simulation these codes are examples, and clearing isn't available.</x:String>
    <x:String x:Key="Faults_Active">Active</x:String>
    <x:String x:Key="Faults_Verified">Verified</x:String>
    <x:String x:Key="Faults_Stored">Stored</x:String>
    <x:String x:Key="Faults_Reading">Reading the fault codes…</x:String>
    <x:String x:Key="Faults_None">No active, verified or stored faults.</x:String>
    <x:String x:Key="Faults_HistoryTitle">This session</x:String>
    <x:String x:Key="Faults_HistoryEmpty">Faults appearing or going away will be listed here.</x:String>
    <x:String x:Key="Faults_Legend">MIL means the fault turns on the engine warning light.</x:String>
    <x:String x:Key="Faults_ClearTitle">Clear the fault codes?</x:String>
    <x:String x:Key="Faults_ClearBody">The codes stored in the ECU will be erased. This can't be undone. They stay in this session's log.</x:String>
    <x:String x:Key="Faults_ClearConfirm">Clear codes</x:String>
    <x:String x:Key="Faults_Cleared">Fault codes cleared.</x:String>
    <x:String x:Key="Faults_ClearFailed">Clearing the codes failed.</x:String>

    <x:String x:Key="Tests_Title">Actuator tests</x:String>
    <x:String x:Key="Tests_Warning">Tests really drive the components (fuel pump, injectors, coils…). Keep clear of moving parts and heat, and follow what each test asks about the engine.</x:String>
    <x:String x:Key="Tests_Max">up to</x:String>
    <x:String x:Key="Tests_Run">Run test</x:String>
    <x:String x:Key="Tests_Cancel">Cancel</x:String>
    <x:String x:Key="Tests_ConfirmBodyOff">The component will really be driven, for up to {0} seconds. Ignition on, engine off.</x:String>
    <x:String x:Key="Tests_ConfirmBodyRunning">The component will really be driven, for up to {0} seconds. This test needs the engine running.</x:String>

    <x:String x:Key="Graph_Title">Graph</x:String>
    <x:String x:Key="Graph_Follow">Follow</x:String>
    <x:String x:Key="Graph_FollowTip">Keep showing the latest values</x:String>
    <x:String x:Key="Graph_Overlay">Overlay</x:String>
    <x:String x:Key="Graph_OverlayTip">Draw all traces in one plot, each on its own scale, to compare their shapes</x:String>
    <x:String x:Key="Graph_Record">Record</x:String>
    <x:String x:Key="Graph_Stop">Stop</x:String>
    <x:String x:Key="Graph_Traces">TRACES</x:String>
    <x:String x:Key="Graph_Help">Wheel: zoom. Drag: move through time. Double-click: back to the latest values.</x:String>
    <x:String x:Key="Graph_Placeholder">Waiting for values. Choose what to read under Parameters.</x:String>

    <x:String x:Key="Adjust_Title">Adjustments</x:String>
    <x:String x:Key="Adjust_Warning">Adjustments change values stored in the ECU. Only use them if you know what they do.</x:String>
    <x:String x:Key="Adjust_Run">Run</x:String>
    <x:String x:Key="Adjust_ConfirmBody">This changes a value stored in the ECU. Continue?</x:String>
    <x:String x:Key="Adjust_Send">Send to ECU</x:String>
    <x:String x:Key="Adjust_Close">Close</x:String>
    <x:String x:Key="Adjust_Sent">Value sent: {0}</x:String>
    <x:String x:Key="Adjust_SendFailed">Communication with the ECU failed: value not confirmed.</x:String>

    <x:String x:Key="Sessions_Title">Session log</x:String>
    <x:String x:Key="Sessions_Import">Open CSV</x:String>
    <x:String x:Key="Sessions_ImportTip">Open a recording from another computer or an earlier version</x:String>
    <x:String x:Key="Sessions_Folder">Folder</x:String>
    <x:String x:Key="Sessions_ExportAll">Export all</x:String>
    <x:String x:Key="Sessions_Export">Export</x:String>
    <x:String x:Key="Sessions_ExportTip">Save as ZIP, with a description of the format: ready to study or to hand to an AI assistant</x:String>
    <x:String x:Key="Sessions_Simulated">Simulated</x:String>
    <x:String x:Key="Sessions_FaultCount">Faults: {0}</x:String>
    <x:String x:Key="Sessions_InProgress">in progress</x:String>
    <x:String x:Key="Sessions_Open">Open</x:String>
    <x:String x:Key="Sessions_Empty">No sessions yet. Every connection to an ECU will be logged here, with the values read and everything that happened.</x:String>
    <x:String x:Key="Sessions_Back">Back to the log</x:String>
    <x:String x:Key="Sessions_FitAll">Whole session</x:String>
    <x:String x:Key="Sessions_CompareWith">Compare with</x:String>
    <x:String x:Key="Sessions_CompareNone">No other session</x:String>
    <x:String x:Key="Sessions_CompareNothingInCommon">These two sessions have no parameters in common.</x:String>
    <x:String x:Key="Sessions_NoData">No values were recorded in this session, only its events.</x:String>
    <x:String x:Key="Sessions_Parameters">PARAMETERS</x:String>
    <x:String x:Key="Sessions_Min">MIN</x:String>
    <x:String x:Key="Sessions_Avg">AVG</x:String>
    <x:String x:Key="Sessions_Max">MAX</x:String>
    <x:String x:Key="Sessions_Events">WHAT HAPPENED</x:String>
    <x:String x:Key="Sessions_Used">Using {0} of {1}. Beyond that, the oldest sessions are deleted.</x:String>
    <x:String x:Key="Sessions_OpenFailed">Can't open it: {0}</x:String>
    <x:String x:Key="Sessions_ImportNotRecognised">This file isn't a recording this program recognises.</x:String>
    <x:String x:Key="Sessions_Exported">Exported.</x:String>
    <x:String x:Key="Sessions_ExportFailed">Export failed: {0}</x:String>
    <x:String x:Key="Sessions_InUse">This session is in progress: disconnect first.</x:String>
    <x:String x:Key="Sessions_DeleteTitle">Delete this session?</x:String>
    <x:String x:Key="Sessions_DeleteBody">{0}, {1}. Its values and events will be erased.</x:String>
    <x:String x:Key="Sessions_DeleteConfirm">Delete</x:String>
    <x:String x:Key="Sessions_DeleteFailed">Can't delete it: {0}</x:String>

    <x:String x:Key="Settings_Title">Settings</x:String>
    <x:String x:Key="Settings_Appearance">Appearance</x:String>
    <x:String x:Key="Settings_Language">Language</x:String>
    <x:String x:Key="Settings_LanguageSystem">Same as the system</x:String>
    <x:String x:Key="Settings_LanguageEnglish">English</x:String>
    <x:String x:Key="Settings_LanguageItalian">Italiano</x:String>
    <x:String x:Key="Settings_Theme">Theme</x:String>
    <x:String x:Key="Settings_ThemeDark">Dark</x:String>
    <x:String x:Key="Settings_ThemeLight">Light</x:String>
    <x:String x:Key="Settings_ThemeSystem">Same as the system</x:String>
    <x:String x:Key="Settings_LanguageNote">Parameter and fault names change language at the next connection.</x:String>
    <x:String x:Key="Settings_Log">Session log</x:String>
    <x:String x:Key="Settings_AutoRecord">Record automatically</x:String>
    <x:String x:Key="Settings_AutoRecordHint">Start recording values as soon as a real ECU connects.</x:String>
    <x:String x:Key="Settings_MaxLog">Maximum size (MB)</x:String>
    <x:String x:Key="Settings_MaxLogHint">Beyond this, the oldest sessions are deleted.</x:String>
    <x:String x:Key="Settings_DataFolder">Where sessions are kept</x:String>
    <x:String x:Key="Settings_Open">Open</x:String>
    <x:String x:Key="Settings_Version">Version</x:String>
    <x:String x:Key="Settings_License">License of the original project (applies to this fork too)</x:String>
