<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:IES_2.Avalonia.ViewModels"
        xmlns:conv="using:Avalonia.Data.Converters"
        x:Class="IES_2.Avalonia.Views.OneByteAdjustWindow"
        x:DataType="vm:OneByteAdjustViewModel"
        Title="{Binding Title}"
        Width="360" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="20" Spacing="12">
        <TextBlock Text="{Binding Title}" Classes="sectionTitle" TextWrapping="Wrap" />

        <Grid ColumnDefinitions="*,50">
            <Slider Grid.Column="0" Minimum="0" Maximum="255" Value="{Binding Value}" TickFrequency="5" />
            <TextBlock Grid.Column="1" Text="{Binding Value}" Classes="monoValue" FontSize="18"
                       HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Opacity="0.8"
                   IsVisible="{Binding StatusMessage, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />

        <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,10,0,0">
            <Button Grid.Column="1" Content="Invia" Command="{Binding ApplyCommand}" Margin="0,0,8,0" />
            <Button Grid.Column="2" Content="Chiudi" Command="{Binding FinishCommand}" />
        </Grid>
    </StackPanel>
</Window>
