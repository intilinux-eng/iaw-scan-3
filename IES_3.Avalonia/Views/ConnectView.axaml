<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:IES_2.Avalonia.ViewModels"
             xmlns:models="using:IES_2.Avalonia.Models"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="IES_2.Avalonia.Views.ConnectView"
             x:DataType="vm:ConnectViewModel">

    <Grid ColumnDefinitions="*,360" ColumnSpacing="20" Margin="24,20">

        <Grid RowDefinitions="Auto,Auto,Auto,*">
            <StackPanel Spacing="4" Margin="0,0,0,14">
                <TextBlock Text="{DynamicResource Connect_Title}" Classes="h1" />
                <TextBlock Text="{DynamicResource Connect_Subtitle}" Classes="muted" TextWrapping="Wrap" />
            </StackPanel>

            <TextBox Grid.Row="1" Text="{Binding SearchText}" PlaceholderText="{DynamicResource Connect_SearchHint}" AutomationProperties.Name="{DynamicResource Connect_SearchHint}" Margin="0,0,0,10">
                <TextBox.InnerLeftContent>
                    <PathIcon Data="{StaticResource IconSearch}" Width="14" Height="14" Margin="10,0,2,0" Foreground="{DynamicResource TextFaintBrush}" />
                </TextBox.InnerLeftContent>
            </TextBox>

            <ItemsControl Grid.Row="2" ItemsSource="{Binding Filters}" Margin="0,0,0,10">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:EcuFilter">
                        <ToggleButton Classes="chip" Margin="0,0,6,6" Content="{Binding Label}" IsChecked="{Binding IsSelected}"
                                      Command="{Binding $parent[ItemsControl].((vm:ConnectViewModel)DataContext).ChooseFilterCommand}"
                                      CommandParameter="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Grid.Row="3" Classes="card" Padding="6">
                <Panel>
                    <ListBox Classes="plain" ItemsSource="{Binding Vehicles}" SelectedItem="{Binding SelectedVehicle}" AutomationProperties.Name="{DynamicResource Connect_Title}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:VehicleChoice">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <PathIcon Data="{StaticResource IconCar}" Width="18" Height="18" Foreground="{DynamicResource TextFaintBrush}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Make}" Classes="small faint" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Classes="pill" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Badge}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{DynamicResource Connect_NoResults}" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsVisible="{Binding !Vehicles.Count}" />
                </Panel>
            </Border>
        </Grid>

        <ScrollViewer Grid.Column="1">
            <StackPanel Spacing="14">
                <Border Classes="card">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{DynamicResource Connect_Chosen}" Classes="label" />
                            <TextBlock Text="{Binding ChosenTitle}" Classes="h2" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ChosenSubtitle}" Classes="small muted" TextWrapping="Wrap" />
                        </StackPanel>

                        <Border Background="{DynamicResource WarnSoftBrush}" CornerRadius="9" Padding="12,8" IsVisible="{Binding IsoOnlyAtIgnitionOn}">
                            <TextBlock Text="{DynamicResource Connect_IsoOnlyAtIgnitionOn}" Classes="small" TextWrapping="Wrap" />
                        </Border>

                        <StackPanel Spacing="6">
                            <TextBlock Text="{DynamicResource Connect_Cable}" Classes="label" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" IsEnabled="{Binding !IsSimulation}">
                                <ComboBox ItemsSource="{Binding Ports}" SelectedItem="{Binding SelectedPortInfo}" HorizontalAlignment="Stretch" AutomationProperties.Name="{DynamicResource Connect_Cable}"
                                          PlaceholderText="{DynamicResource Connect_NoPorts}" />
                                <Button Grid.Column="1" Classes="icon" Command="{Binding RefreshPortsCommand}" ToolTip.Tip="{DynamicResource Connect_RefreshPorts}" AutomationProperties.Name="{DynamicResource Connect_RefreshPorts}">
                                    <PathIcon Data="{StaticResource IconRefresh}" />
                                </Button>
                            </Grid>
                            <TextBlock Text="{DynamicResource Connect_PlugCable}" Classes="small muted" TextWrapping="Wrap"
                                       IsVisible="{Binding !HasPort}" />
                            <Border Background="{DynamicResource WarnSoftBrush}" CornerRadius="9" Padding="12,8"
                                    IsVisible="{Binding DriverMessage, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{Binding DriverMessage}" Classes="small" TextWrapping="Wrap" />
                                    <Button Classes="ghost" Padding="10,6" Content="{DynamicResource Connect_DriverGet}" Command="{Binding GetDriverCommand}" IsVisible="{Binding HasDriverPage}" />
                                </StackPanel>
                            </Border>
                            <Button Classes="ghost" Padding="10,6" Margin="0,2,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsVisible="{Binding HasPort}"
                                    Content="{DynamicResource Connect_TestCable}" Command="{Binding TestCableCommand}" ToolTip.Tip="{DynamicResource Connect_TestCableTip}" />
                            <TextBlock Text="{DynamicResource Connect_TestRunning}" Classes="small muted" IsVisible="{Binding IsTestingCable}" />
                            <Border Classes="cableResult" Classes.ok="{Binding CableTestPassed}" CornerRadius="9" Padding="12,8"
                                    IsVisible="{Binding CableTestMessage, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                                <TextBlock Text="{Binding CableTestMessage}" Classes="small" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Connect_Simulation}" FontWeight="Medium" />
                                <TextBlock Text="{DynamicResource Connect_SimulationHint}" Classes="small muted" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsSimulation}" OnContent="" OffContent="" VerticalAlignment="Center" Margin="10,0,-8,0" AutomationProperties.Name="{DynamicResource Connect_Simulation}" />
                        </Grid>

                        <Button Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="14,12" AutomationProperties.Name="{DynamicResource Connect_Connect}"
                                Command="{Binding ConnectCommand}" IsVisible="{Binding !IsConnecting}" ToolTip.Tip="F10">
                            <TextBlock Text="{DynamicResource Connect_Connect}" FontSize="15" />
                        </Button>

                        <StackPanel Spacing="8" IsVisible="{Binding IsConnecting}">
                            <ProgressBar IsIndeterminate="True" Height="4" MinHeight="4" />
                            <TextBlock Text="{DynamicResource Connect_Waiting}" Classes="small muted" TextWrapping="Wrap" IsVisible="{Binding !IsoOnlyAtIgnitionOn}" />
                            <StackPanel Spacing="2" IsVisible="{Binding IsoOnlyAtIgnitionOn}">
                                <TextBlock Text="{DynamicResource Connect_WaitingTurnOn}" Classes="h3" TextWrapping="Wrap" />
                                <TextBlock Text="{DynamicResource Connect_WaitingCode}" Classes="small muted" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Classes="ghost" Content="{DynamicResource Connect_Cancel}" Command="{Binding CancelCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                        </StackPanel>

                        <Border Background="{DynamicResource DangerSoftBrush}" CornerRadius="9" Padding="12,8"
                                IsVisible="{Binding ErrorMessage, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Classes="small danger" />
                        </Border>
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{DynamicResource Connect_BeforeTitle}" Classes="h3" />
                        <TextBlock Text="{DynamicResource Connect_Before1}" Classes="small muted" TextWrapping="Wrap" IsVisible="{Binding !IsoOnlyAtIgnitionOn}" />
                        <TextBlock Text="{DynamicResource Connect_BeforeIgnitionOff}" Classes="small muted" TextWrapping="Wrap" IsVisible="{Binding IsoOnlyAtIgnitionOn}" />
                        <TextBlock Text="{DynamicResource Connect_Before2}" Classes="small muted" TextWrapping="Wrap" />
                        <TextBlock Text="{DynamicResource Connect_Before3}" Classes="small muted" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
