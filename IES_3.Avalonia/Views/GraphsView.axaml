<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:IES_2.Avalonia.ViewModels"
             xmlns:models="using:IES_2.Avalonia.Models"
             xmlns:controls="using:IES_2.Avalonia.Controls"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="IES_2.Avalonia.Views.GraphsView"
             x:DataType="vm:GraphsViewModel">

    <Grid RowDefinitions="Auto,Auto,*" ColumnDefinitions="230,*" Margin="16">

        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <TextBlock Grid.Column="0" Text="Grafico in tempo reale" Classes="sectionTitle" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Interrompi [S]" Command="{Binding ToggleRecordingCommand}" IsVisible="{Binding IsRecording}" />
            <Button Grid.Column="1" Content="Avvia registrazione [S]" Command="{Binding ToggleRecordingCommand}" IsVisible="{Binding !IsRecording}" />
        </Grid>

        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding StatusMessage}" TextWrapping="Wrap"
                   Foreground="OrangeRed" Margin="0,0,0,10"
                   IsVisible="{Binding StatusMessage, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />

        <Border Grid.Row="2" Grid.Column="0" Classes="card" Margin="0,0,12,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="TRACCIATI" Classes="colHeader" Margin="0,0,0,8" />
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Traces}" IsEnabled="{Binding !IsRecording}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:TraceOption">
                                <Grid ColumnDefinitions="Auto,Auto,*" Margin="0,4">
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsPlotted}" />
                                    <Border Grid.Column="1" Width="10" Height="10" CornerRadius="5"
                                            VerticalAlignment="Center" Margin="2,0,6,0">
                                        <Border.Background>
                                            <SolidColorBrush Color="{Binding Color}" />
                                        </Border.Background>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding Description}" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Grid.Column="1" Classes="card">
            <controls:LiveLineChart x:Name="Chart" Series="{Binding Series}" />
        </Border>
    </Grid>
</UserControl>
