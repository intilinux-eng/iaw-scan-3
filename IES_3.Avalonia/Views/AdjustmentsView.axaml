<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:IES_2.Avalonia.ViewModels"
             xmlns:models="using:IES_2.Avalonia.Models"
             x:Class="IES_2.Avalonia.Views.AdjustmentsView"
             x:DataType="vm:AdjustmentsViewModel">

    <Grid RowDefinitions="Auto,Auto,*" Margin="24,18">
        <TextBlock Text="{DynamicResource Adjust_Title}" Classes="h1" Margin="0,0,0,12" />

        <Border Grid.Row="1" Classes="warnCard" Margin="0,0,0,14">
            <TextBlock Text="{DynamicResource Adjust_Warning}" TextWrapping="Wrap" />
        </Border>

        <ScrollViewer Grid.Row="2">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:AdjustRow">
                        <Border Classes="card" Width="310" Padding="14,12" Margin="0,0,10,10">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <StackPanel Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Description}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <Border Classes="pill ok" Padding="8,1" HorizontalAlignment="Left" IsVisible="{Binding Passed}">
                                        <TextBlock Text="{Binding ResultText}" />
                                    </Border>
                                    <Border Classes="pill danger" Padding="8,1" HorizontalAlignment="Left" IsVisible="{Binding Failed}">
                                        <TextBlock Text="{Binding ResultText}" />
                                    </Border>
                                </StackPanel>
                                <Button Grid.Column="1" Classes="primary" Padding="12,6" VerticalAlignment="Center"
                                        Command="{Binding $parent[ItemsControl].((vm:AdjustmentsViewModel)DataContext).RunCommand}" CommandParameter="{Binding}">
                                    <TextBlock Text="{DynamicResource Adjust_Run}" FontSize="12" />
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
