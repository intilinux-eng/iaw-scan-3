<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:IES_2.Avalonia.ViewModels"
             xmlns:models="using:IES_2.Avalonia.Models"
             x:Class="IES_2.Avalonia.Views.ParametersView"
             x:DataType="vm:ParametersViewModel">

    <Grid RowDefinitions="Auto,Auto,*" Margin="24,18,14,0">

        <Grid ColumnDefinitions="*,220,Auto" ColumnSpacing="8" Margin="0,0,10,4">
            <TextBlock Text="{DynamicResource Parameters_Title}" Classes="h1" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding SearchText}" PlaceholderText="{DynamicResource Parameters_Search}" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <ToggleButton Classes="chip" Content="{DynamicResource Parameters_SelectedOnly}" IsChecked="{Binding SelectedOnly}" />
                <Button Classes="ghost" Padding="10,6" Command="{Binding SelectAllCommand}"><TextBlock Text="{DynamicResource Parameters_All}" FontSize="12" /></Button>
                <Button Classes="ghost" Padding="10,6" Command="{Binding SelectNoneCommand}"><TextBlock Text="{DynamicResource Parameters_None}" FontSize="12" /></Button>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="1" Text="{DynamicResource Parameters_Hint}" Classes="small muted" Margin="0,0,10,12" TextWrapping="Wrap" />

        <ScrollViewer Grid.Row="2">
            <ItemsControl ItemsSource="{Binding Visible}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:ParameterRow">
                        <ToggleButton Classes="paramCard" IsChecked="{Binding IsChecked}" AutomationProperties.Name="{Binding Description}">
                            <Grid RowDefinitions="*,Auto" ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                <Border Grid.Column="1" Width="20" Height="20" CornerRadius="6" Margin="6,0,0,0" VerticalAlignment="Top"
                                        BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                                        IsVisible="{Binding !IsChecked}" />
                                <Border Grid.Column="1" Width="20" Height="20" CornerRadius="6" Margin="6,0,0,0" VerticalAlignment="Top"
                                        Background="{DynamicResource AccentBrush}" IsVisible="{Binding IsChecked}">
                                    <PathIcon Data="{StaticResource IconCheck}" Width="14" Height="14" Foreground="White" />
                                </Border>
                                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="5">
                                    <TextBlock Text="{Binding Value}" Classes="number" Classes.danger="{Binding IsInvalid}" FontSize="22" />
                                    <TextBlock Text="{Binding Unit}" Classes="small muted" VerticalAlignment="Bottom" Margin="0,0,0,3" IsVisible="{Binding IsChecked}" />
                                </StackPanel>
                            </Grid>
                        </ToggleButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
