<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:IES_2.Avalonia.ViewModels"
        xmlns:views="using:IES_2.Avalonia.Views"
        xmlns:controls="using:IES_2.Avalonia.Controls"
        xmlns:conv="using:Avalonia.Data.Converters"
        x:Class="IES_2.Avalonia.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="IAW Scan 3"
        Icon="/Assets/app.ico"
        Width="1240" Height="800" MinWidth="900" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}">

    <Window.KeyBindings>
        <KeyBinding Gesture="F2" Command="{Binding NavigateCommand}" CommandParameter="dashboard" />
        <KeyBinding Gesture="F3" Command="{Binding NavigateCommand}" CommandParameter="parameters" />
        <KeyBinding Gesture="F4" Command="{Binding NavigateCommand}" CommandParameter="faults" />
        <KeyBinding Gesture="F5" Command="{Binding NavigateCommand}" CommandParameter="tests" />
        <KeyBinding Gesture="F6" Command="{Binding NavigateCommand}" CommandParameter="graph" />
        <KeyBinding Gesture="F7" Command="{Binding NavigateCommand}" CommandParameter="adjustments" />
        <KeyBinding Gesture="F8" Command="{Binding NavigateCommand}" CommandParameter="sessions" />
        <KeyBinding Gesture="F9" Command="{Binding NavigateCommand}" CommandParameter="settings" />
        <KeyBinding Gesture="F10" Command="{Binding ConnectToggleCommand}" />
        <KeyBinding Gesture="F11" Command="{Binding ToggleImmersiveCommand}" />
        <KeyBinding Gesture="Escape" Command="{Binding EscapeCommand}" />
    </Window.KeyBindings>

    <Window.DataTemplates>
        <DataTemplate x:DataType="vm:ConnectViewModel"><views:ConnectView /></DataTemplate>
        <DataTemplate x:DataType="vm:DashboardViewModel"><views:DashboardView /></DataTemplate>
        <DataTemplate x:DataType="vm:ParametersViewModel"><views:ParametersView /></DataTemplate>
        <DataTemplate x:DataType="vm:FaultsViewModel"><views:FaultsView /></DataTemplate>
        <DataTemplate x:DataType="vm:TestsViewModel"><views:TestsView /></DataTemplate>
        <DataTemplate x:DataType="vm:GraphViewModel"><views:GraphView /></DataTemplate>
        <DataTemplate x:DataType="vm:AdjustmentsViewModel"><views:AdjustmentsView /></DataTemplate>
        <DataTemplate x:DataType="vm:SessionsViewModel"><views:SessionsView /></DataTemplate>
        <DataTemplate x:DataType="vm:SettingsViewModel"><views:SettingsView /></DataTemplate>
    </Window.DataTemplates>

    <Grid>
        <Grid ColumnDefinitions="Auto,*">

            <!-- Sidebar -->
            <Border Grid.Column="0" Width="212" IsVisible="{Binding !IsImmersive}"
                    Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,1,0" Padding="12,14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="6,0,0,20">
                        <Border Classes="logo" Width="34" Height="34">
                            <PathIcon Data="{StaticResource IconGauge}" Width="20" Height="20" Foreground="White" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="IAW Scan 3" FontWeight="Bold" FontSize="15" />
                            <TextBlock Text="{DynamicResource App_Tagline}" Classes="faint" FontSize="11" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Spacing="2">
                        <Button Classes="nav" AutomationProperties.Name="{DynamicResource Nav_Sessions}" Command="{Binding NavigateCommand}" CommandParameter="sessions"
                                Classes.active="{Binding CurrentKey, Converter={x:Static controls:EqualsConverter.Instance}, ConverterParameter=sessions}">
                            <StackPanel Orientation="Horizontal" Spacing="11">
                                <PathIcon Data="{StaticResource IconLog}" />
                                <TextBlock Text="{DynamicResource Nav_Sessions}" />
                            </StackPanel>
                        </Button>
                        <Button Classes="nav" AutomationProperties.Name="{DynamicResource Nav_Settings}" Command="{Binding NavigateCommand}" CommandParameter="settings"
                                Classes.active="{Binding CurrentKey, Converter={x:Static controls:EqualsConverter.Instance}, ConverterParameter=settings}">
                            <StackPanel Orientation="Horizontal" Spacing="11">
                                <PathIcon Data="{StaticResource IconGear}" />
                                <TextBlock Text="{DynamicResource Nav_Settings}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <Button Classes="nav" AutomationProperties.Name="{DynamicResource Nav_Connect}" Command="{Binding NavigateCommand}" CommandParameter="connect" IsVisible="{Binding !IsConnected}"
                                Classes.active="{Binding CurrentKey, Converter={x:Static controls:EqualsConverter.Instance}, ConverterParameter=connect}">
                            <StackPanel Orientation="Horizontal" Spacing="11">
                                <PathIcon Data="{StaticResource IconPlug}" />
                                <TextBlock Text="{DynamicResource Nav_Connect}" />
                            </StackPanel>
                        </Button>

                        <Button Classes="nav" AutomationProperties.Name="{DynamicResource Nav_Dashboard}" Command="{Binding NavigateCommand}" CommandParameter="dashboard" IsVisible="{Binding IsConnected}"
                                Classes.active="{Binding CurrentKey, Converter={x:Static controls:EqualsConverter.Instance}, ConverterParameter=dashboard}">
                            <StackPanel Orientation="Horizontal" Spacing="11">
                                <PathIcon Data="{StaticResource IconGauge}" />
                                <TextBlock Text="{DynamicResource Nav_Dashboard}" />
                            </StackPanel>
                        </Button>
                        <Button Classes="nav" AutomationProperties.Name="{DynamicResource Nav_Parameters}" Command="{Binding NavigateCommand}" CommandParameter="parameters" IsVisible="{Binding IsConnected}"
                                Classes.active="{Binding CurrentKey, Converter={x:Static controls:EqualsConverter.Instance}, ConverterParameter=parameters}">
                            <StackPanel Orientation="Horizontal" Spacing="11">
                                <PathIcon Data="{StaticResource IconGrid}" />
                                <TextBlock Text="{DynamicResource Nav_Parameters}" />
                            </StackPanel>
                        </Button>
                        <Button Classes="nav" AutomationProperties.Name="{DynamicResource Nav_Faults}" Command="{Binding NavigateCommand}" CommandParameter="faults" IsVisible="{Binding IsConnected}"
                                Classes.active="{Binding CurrentKey, Converter={x:Static controls:EqualsConverter.Instance}, ConverterParameter=faults}">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Orientation="Horizontal" Spacing="11">
                                    <PathIcon Data="{StaticResource IconAlert}" />
                                    <TextBlock Text="{DynamicResource Nav_Faults}" />
                                </StackPanel>
                                <Border Grid.Column="1" CornerRadius="999" MinWidth="20" Height="20" Padding="5,0"
                                        Background="{DynamicResource DangerBrush}"
                                        IsVisible="{Binding Live.Faults.Count, FallbackValue=0, Converter={x:Static controls:IsPositiveConverter.Instance}}">
                                    <TextBlock Text="{Binding Live.Faults.Count}" Foreground="White" FontSize="11" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Button>
                        <Button Classes="nav" AutomationProperties.Name="{DynamicResource Nav_Tests}" Command="{Binding NavigateCommand}" CommandParameter="tests" IsVisible="{Binding HasTests}"
                                Classes.active="{Binding CurrentKey, Converter={x:Static controls:EqualsConverter.Instance}, ConverterParameter=tests}">
                            <StackPanel Orientation="Horizontal" Spacing="11">
                                <PathIcon Data="{StaticResource IconBolt}" />
                                <TextBlock Text="{DynamicResource Nav_Tests}" />
                            </StackPanel>
                        </Button>
                        <Button Classes="nav" AutomationProperties.Name="{DynamicResource Nav_Graph}" Command="{Binding NavigateCommand}" CommandParameter="graph" IsVisible="{Binding IsConnected}"
                                Classes.active="{Binding CurrentKey, Converter={x:Static controls:EqualsConverter.Instance}, ConverterParameter=graph}">
                            <StackPanel Orientation="Horizontal" Spacing="11">
                                <PathIcon Data="{StaticResource IconChart}" />
                                <TextBlock Text="{DynamicResource Nav_Graph}" />
                            </StackPanel>
                        </Button>
                        <Button Classes="nav" AutomationProperties.Name="{DynamicResource Nav_Adjustments}" Command="{Binding NavigateCommand}" CommandParameter="adjustments" IsVisible="{Binding HasAdjustments}"
                                Classes.active="{Binding CurrentKey, Converter={x:Static controls:EqualsConverter.Instance}, ConverterParameter=adjustments}">
                            <StackPanel Orientation="Horizontal" Spacing="11">
                                <PathIcon Data="{StaticResource IconSliders}" />
                                <TextBlock Text="{DynamicResource Nav_Adjustments}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*">

                <!-- Status bar -->
                <Border Grid.Row="0" IsVisible="{Binding !IsImmersive}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,0,1"
                        Background="{DynamicResource SidebarBrush}" Padding="20,10">
                    <Grid ColumnDefinitions="*,Auto" MinHeight="36">
                        <StackPanel VerticalAlignment="Center" IsVisible="{Binding !IsConnected}">
                            <TextBlock Text="{DynamicResource Status_NotConnected}" Classes="h3" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center" IsVisible="{Binding IsConnected}">
                            <TextBlock Text="{Binding Live.CarModel, FallbackValue=''}" Classes="h3" TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="small faint" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding Live.EcuType, FallbackValue=''}" />
                                <Run Text="  ·  ISO " />
                                <Run Text="{Binding Live.IsoCode, FallbackValue=''}" />
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding IsConnected}">
                            <Border Classes="pill accent" IsVisible="{Binding IsSimulation}">
                                <TextBlock Text="{DynamicResource Status_Simulation}" />
                            </Border>
                            <Border Classes="pill ok" IsVisible="{Binding !IsSimulation}">
                                <TextBlock Text="{DynamicResource Status_Connected}" />
                            </Border>
                            <Button Classes="ghost" Padding="10,6" AutomationProperties.Name="{DynamicResource Status_Record}" Command="{Binding ToggleRecordingCommand}"
                                    ToolTip.Tip="{DynamicResource Status_RecordTip}">
                                <Panel>
                                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding Live.IsRecording, FallbackValue=False}">
                                        <Ellipse Classes="dot" Fill="{DynamicResource DangerBrush}" />
                                        <TextBlock Text="{DynamicResource Status_Recording}" FontSize="12" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding !Live.IsRecording, FallbackValue=False}">
                                        <Ellipse Classes="dot" Fill="{DynamicResource TextFaintBrush}" />
                                        <TextBlock Text="{DynamicResource Status_Record}" FontSize="12" />
                                    </StackPanel>
                                </Panel>
                            </Button>
                            <Button Classes="ghost" Padding="10,6" AutomationProperties.Name="{DynamicResource Status_Disconnect}" Command="{Binding DisconnectCommand}" ToolTip.Tip="F10">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="{StaticResource IconClose}" Width="12" Height="12" />
                                    <TextBlock Text="{DynamicResource Status_Disconnect}" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Banners -->
                <StackPanel Grid.Row="1">
                    <Border Background="{DynamicResource DangerBrush}" Padding="20,8" IsVisible="{Binding Live.IsCommunicationLost, FallbackValue=False}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{DynamicResource Banner_CommLost}" Foreground="White" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <Button Grid.Column="1" Content="{DynamicResource Banner_Reconnect}" Command="{Binding ReconnectCommand}" Margin="12,0,0,0"
                                    Background="White" Foreground="#A51111" Padding="12,5" />
                        </Grid>
                    </Border>
                    <Border Background="{DynamicResource WarnSoftBrush}" Padding="20,8" IsVisible="{Binding EcuNotAnswering}">
                        <TextBlock Text="{DynamicResource Banner_NotAnswering}" TextWrapping="Wrap" />
                    </Border>
                    <Border Background="{DynamicResource WarnSoftBrush}" Padding="20,8" IsVisible="{Binding CarNotIdentified}">
                        <TextBlock Text="{DynamicResource Banner_CarNotIdentified}" TextWrapping="Wrap" />
                    </Border>
                    <Border Background="{DynamicResource AccentSoftBrush}" Padding="20,6" IsVisible="{Binding IsSimulation}">
                        <TextBlock Text="{DynamicResource Banner_Simulation}" FontSize="12" />
                    </Border>
                </StackPanel>

                <ContentControl Grid.Row="2" Content="{Binding CurrentPage}" />
            </Grid>
        </Grid>

        <!-- Modal layer -->
        <Border Background="{DynamicResource ScrimBrush}" IsVisible="{Binding Dialog.IsConfirmOpen}">
            <Border Classes="card" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22">
                <StackPanel Spacing="14">
                    <TextBlock Text="{Binding Dialog.Title}" Classes="h2" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Dialog.Body}" Classes="muted" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
                        <Button Classes="ghost" Content="{DynamicResource Dialog_Cancel}" Command="{Binding Dialog.CancelCommand}" />
                        <Button Classes="primary" Content="{Binding Dialog.ConfirmText}" Command="{Binding Dialog.AcceptCommand}" IsVisible="{Binding !Dialog.IsDangerous}" />
                        <Button Classes="dangerButton" Content="{Binding Dialog.ConfirmText}" Command="{Binding Dialog.AcceptCommand}" IsVisible="{Binding Dialog.IsDangerous}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <Border Background="{DynamicResource ScrimBrush}"
                IsVisible="{Binding Dialog.OneByte, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
            <Border Classes="card" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22"
                    DataContext="{Binding Dialog.OneByte}">
                <StackPanel Spacing="14" x:DataType="vm:OneByteAdjustViewModel">
                    <TextBlock Text="{Binding Title}" Classes="h2" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ValueText}" Classes="number" FontSize="44" HorizontalAlignment="Center" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Button Classes="ghost" Content="−" Command="{Binding StepCommand}" CommandParameter="-1" Width="44" HorizontalContentAlignment="Center" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding Value}" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Classes="ghost" Content="+" Command="{Binding StepCommand}" CommandParameter="1" Width="44" HorizontalContentAlignment="Center" />
                    </Grid>
                    <TextBlock Text="{Binding StatusMessage}" Classes="muted" TextWrapping="Wrap"
                               IsVisible="{Binding StatusMessage, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Classes="ghost" Content="{DynamicResource Adjust_Close}" Command="{Binding FinishCommand}" />
                        <Button Classes="primary" Content="{DynamicResource Adjust_Send}" Command="{Binding ApplyCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- The way out of the fullscreen dashboard -->
        <Button Classes="ghost" IsVisible="{Binding IsImmersive}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
                Command="{Binding ToggleImmersiveCommand}" Content="{DynamicResource Dashboard_ExitFullscreen}" />
    </Grid>
</Window>
