<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:IES_2.Avalonia.ViewModels"
             xmlns:models="using:IES_2.Avalonia.Models"
             x:Class="IES_2.Avalonia.Views.TestsView"
             x:DataType="vm:TestsViewModel">

    <Grid RowDefinitions="Auto,Auto,*" Margin="24,18">
        <TextBlock Text="{DynamicResource Tests_Title}" Classes="h1" Margin="0,0,0,12" />

        <Border Grid.Row="1" Classes="warnCard" Margin="0,0,0,14">
            <TextBlock Text="{DynamicResource Tests_Warning}" TextWrapping="Wrap" />
        </Border>

        <ScrollViewer Grid.Row="2">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:TestRow">
                        <Border Classes="card" Width="310" Padding="14,12" Margin="0,0,10,10">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <StackPanel Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Description}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Classes="small faint" VerticalAlignment="Center">
                                            <Run Text="{DynamicResource Tests_Max}" />
                                            <Run Text="{Binding MaxSeconds}" />
                                            <Run Text="s" />
                                        </TextBlock>
                                        <Border Classes="pill ok" Padding="8,1" IsVisible="{Binding Passed}">
                                            <TextBlock Text="{Binding ResultText}" />
                                        </Border>
                                        <Border Classes="pill danger" Padding="8,1" IsVisible="{Binding Failed}">
                                            <TextBlock Text="{Binding ResultText}" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                                <Panel Grid.Column="1" VerticalAlignment="Center">
                                    <Button Classes="primary" Padding="12,6" IsVisible="{Binding !IsRunning}"
                                            Command="{Binding $parent[ItemsControl].((vm:TestsViewModel)DataContext).RunCommand}" CommandParameter="{Binding}">
                                        <TextBlock Text="{DynamicResource Tests_Run}" FontSize="12" />
                                    </Button>
                                    <Button Classes="ghost" Padding="12,6" IsVisible="{Binding IsRunning}"
                                            Command="{Binding $parent[ItemsControl].((vm:TestsViewModel)DataContext).CancelCommand}">
                                        <TextBlock Text="{DynamicResource Tests_Cancel}" FontSize="12" />
                                    </Button>
                                </Panel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
