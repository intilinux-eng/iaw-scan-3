<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:IES_2.Avalonia.ViewModels"
             xmlns:models="using:IES_2.Avalonia.Models"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="IES_2.Avalonia.Views.FaultsView"
             x:DataType="vm:FaultsViewModel">

    <Grid RowDefinitions="Auto,Auto,*" ColumnDefinitions="*,300" ColumnSpacing="20" Margin="24,18">

        <Grid Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="{DynamicResource Faults_Title}" Classes="h1" VerticalAlignment="Center" />
                <Border Classes="pill danger" VerticalAlignment="Center" IsVisible="{Binding !!Live.Faults.Count}">
                    <TextBlock Text="{Binding Live.Faults.Count}" />
                </Border>
            </StackPanel>
            <Button Grid.Column="1" Classes="dangerButton" Command="{Binding ClearCodesCommand}" VerticalAlignment="Center" AutomationProperties.Name="{DynamicResource Faults_Clear}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <PathIcon Data="{StaticResource IconTrash}" Width="14" Height="14" />
                    <TextBlock Text="{DynamicResource Faults_Clear}" />
                </StackPanel>
            </Button>
        </Grid>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="4" Margin="0,0,0,12">
            <TextBlock Text="{DynamicResource Faults_SimulationNote}" Classes="small muted" IsVisible="{Binding Live.IsSimulation}" />
            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="9" Padding="12,8"
                    IsVisible="{Binding StatusMessage, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                <TextBlock Text="{Binding StatusMessage}" FontWeight="SemiBold" />
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="2">
            <Panel>
                <ItemsControl ItemsSource="{Binding Live.Faults}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:FaultRow">
                            <Border Classes="card" Padding="14,12" Margin="0,0,10,8">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border Width="4" CornerRadius="2" Background="{DynamicResource WarnBrush}" IsVisible="{Binding !MilOn}" />
                                    <Border Width="4" CornerRadius="2" Background="{DynamicResource DangerBrush}" IsVisible="{Binding MilOn}" />
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="{Binding Description}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Reason}" Classes="small muted" TextWrapping="Wrap" IsVisible="{Binding HasReason}" />
                                        <WrapPanel Margin="0,2,0,0">
                                            <Border Classes="pill warn" Margin="0,0,6,0" Padding="8,2" IsVisible="{Binding IsActive}">
                                                <TextBlock Text="{DynamicResource Faults_Active}" />
                                            </Border>
                                            <Border Classes="pill accent" Margin="0,0,6,0" Padding="8,2" IsVisible="{Binding IsVerified}">
                                                <TextBlock Text="{DynamicResource Faults_Verified}" />
                                            </Border>
                                            <Border Classes="pill" Margin="0,0,6,0" Padding="8,2" IsVisible="{Binding IsStored}">
                                                <TextBlock Text="{DynamicResource Faults_Stored}" />
                                            </Border>
                                        </WrapPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="4" HorizontalAlignment="Right">
                                        <Border Classes="pill danger" HorizontalAlignment="Right" Padding="8,2" IsVisible="{Binding MilOn}">
                                            <TextBlock Text="MIL" />
                                        </Border>
                                        <TextBlock Text="{Binding FirstSeen}" Classes="small faint" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel HorizontalAlignment="Center" Spacing="10" Margin="0,70,0,0" IsVisible="{Binding !Live.FaultsRead}">
                    <ProgressBar IsIndeterminate="True" Width="160" Height="4" MinHeight="4" />
                    <TextBlock Text="{DynamicResource Faults_Reading}" Classes="muted" HorizontalAlignment="Center" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Center" Spacing="10" Margin="0,70,0,0" IsVisible="{Binding IsClean}">
                    <PathIcon Data="{StaticResource IconCheck}" Width="42" Height="42" Foreground="{DynamicResource OkBrush}" />
                    <TextBlock Text="{DynamicResource Faults_None}" Classes="muted" HorizontalAlignment="Center" />
                </StackPanel>
            </Panel>
        </ScrollViewer>

        <Border Grid.Row="2" Grid.Column="1" Classes="card" VerticalAlignment="Top">
            <StackPanel Spacing="10">
                <TextBlock Text="{DynamicResource Faults_HistoryTitle}" Classes="h3" />
                <TextBlock Text="{DynamicResource Faults_HistoryEmpty}" Classes="small muted" TextWrapping="Wrap" IsVisible="{Binding !Live.FaultHistory.Count}" />
                <ItemsControl ItemsSource="{Binding Live.FaultHistory}" MaxHeight="360">
                    <ItemsControl.Template>
                        <ControlTemplate>
                            <ScrollViewer>
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:FaultHistoryRow">
                            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8" Margin="0,0,0,6">
                                <TextBlock Text="{Binding Time}" Classes="small faint" FontFeatures="tnum" />
                                <Panel Grid.Column="1" Width="12">
                                    <TextBlock Text="+" Classes="small danger" FontWeight="Bold" IsVisible="{Binding Appeared}" />
                                    <TextBlock Text="−" Classes="small" Foreground="{DynamicResource OkBrush}" FontWeight="Bold" IsVisible="{Binding !Appeared}" />
                                </Panel>
                                <TextBlock Grid.Column="2" Text="{Binding Description}" Classes="small" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{DynamicResource Faults_Legend}" Classes="small faint" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
