<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:IES_2.Avalonia.ViewModels"
        xmlns:models="using:IES_2.Avalonia.Models"
        xmlns:sys="using:System"
        xmlns:conv="using:Avalonia.Data.Converters"
        x:Class="IES_2.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="IAW Scan 2"
        Width="960" Height="640">

    <Window.Styles>
        <Style Selector="Border.badge">
            <Setter Property="Background" Value="#3B5BDB" />
        </Style>
        <Style Selector="Border.chip">
            <Setter Property="Background" Value="#22808080" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="14">

        <TextBlock Grid.Row="0" Text="Seleziona ECU" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />

        <Grid Grid.Row="1" ColumnDefinitions="300,*">

            <ListBox Grid.Column="0"
                     ItemsSource="{Binding EcuOptions}"
                     SelectedItem="{Binding SelectedEcuOption}"
                     Margin="0,0,10,0">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:EcuOption">
                        <Border CornerRadius="8" Padding="10,8">
                            <Grid ColumnDefinitions="46,10,*">
                                <Border Grid.Column="0" Classes="badge"
                                        Height="30" CornerRadius="6" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Badge}" Foreground="White" FontSize="10" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" FontWeight="Medium" />
                                    <TextBlock Text="{Binding VehicleCount, StringFormat='{}{0} veicoli supportati'}"
                                               FontSize="11" Opacity="0.65" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="10">
                <DockPanel>
                    <TextBox DockPanel.Dock="Top" PlaceholderText="Cerca veicolo..." Text="{Binding SearchText}" Margin="0,0,0,10" />
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding FilteredVehicleGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:VehicleGroup">
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="{Binding Brand}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                        <ItemsControl ItemsSource="{Binding Vehicles}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="sys:String">
                                                    <Border Classes="chip">
                                                        <TextBlock Text="{Binding}" FontSize="12" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" RowDefinitions="Auto,Auto,Auto" Margin="0,12,0,0">

            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="0,0,0,8">
                <TextBlock Grid.Column="0" Text="Porta COM:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding ComPorts}" SelectedItem="{Binding SelectedComPort}"
                          HorizontalAlignment="Left" MinWidth="140" />
                <CheckBox Grid.Column="2" Content="Modalità simulazione (nessun hardware)"
                          IsChecked="{Binding IsSimulationMode}" Margin="16,0" VerticalAlignment="Center" />
                <Button Grid.Column="3" Content="Connetti" Command="{Binding ConnectCommand}" Margin="0,0,8,0" />
                <Button Grid.Column="4" Content="Annulla" Command="{Binding CancelConnectCommand}"
                        IsVisible="{Binding IsConnecting}" Margin="0,0,8,0" />
                <Button Content="Disconnetti" Command="{Binding DisconnectCommand}"
                        IsVisible="{Binding IsConnected}" Grid.Column="4" />
            </Grid>

            <TextBlock Grid.Row="1" Text="{Binding ErrorMessage}" Foreground="Red"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                       Margin="0,0,0,8" TextWrapping="Wrap" />

            <Grid Grid.Row="2" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="Tipo ECU: " FontWeight="SemiBold" />
                    <TextBlock Text="{Binding EcuTypeText}" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="Modello auto: " FontWeight="SemiBold" />
                    <TextBlock Text="{Binding CarModelText}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Codice ISO: " FontWeight="SemiBold" />
                    <TextBlock Text="{Binding IsoCodeText}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="Codice del pezzo: " FontWeight="SemiBold" />
                    <TextBlock Text="{Binding RepCodeText}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
